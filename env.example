# 部署目标：local | cloudflare | vercel | deno | docker
DEPLOY_TARGET=local
PORT=8787
LOG_LEVEL=debug
# 本地开发种子密码（仅 local 默认值；任何真实部署必须更改）
DEV_SEED_AUTH_PASSWORD=change-me-in-dev
# 字段级 AES-GCM 加密密钥（生产必须配置，见 docs/Deployment.md §1）
APP_ENCRYPTION_KEY=
# Turso 连接信息（vercel/deno/docker 默认数据库；cloudflare 仅 FORCE_TURSO=1 时需要）
TURSO_URL=
TURSO_AUTH_TOKEN=
# Cloudflare 上强制改用 Turso
FORCE_TURSO=
# VPS 上改用本机磁盘 SQLite（docker 目标可选）
LOCAL_SQLITE_PATH=
