# ============================================================
# vanilla-js-template — 环境变量示例
#
# 使用方式：cp .env.example .env，按需填写。
# .env 已被 .gitignore 忽略，不会提交；本地运行通过
# `deno run --env-file=.env ...`（各 just 任务已内置）自动加载。
#
# 完整变量矩阵与各平台差异见 docs/Deployment.md §1；
# 数据库选择逻辑见 docs/Database.md §3；日志级别见 docs/Logging.md §4。
# ============================================================

# ---- 运行时目标 ----
# local | cloudflare | vercel | deno | docker
# 决定 shared/db/resolve.js 选用哪个数据库适配器，由各
# platform-adapters/*.entry.js 在启动时显式传入，本地开发用 local。
DEPLOY_TARGET=local

# ---- 安全（必需，四个平台均需要）----
# 敏感字段（邮箱/手机/密码/API Key/Token 等）AES-GCM 加密密钥，见 docs/Database.md §5.2。
# 本地开发可用任意随机字符串；生产环境必须为高强度随机值，且不同平台/环境使用不同的值。
# 生成示例：openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---- 数据库 ----
# local 目标默认使用本机 SQLite；留空则用默认路径 .data/dev.sqlite3（已在 .gitignore 中）。
# docker(VPS) 目标下设置此项可从 Turso 切换回本机磁盘 SQLite，见 docs/Database.md §3。
LOCAL_SQLITE_PATH=.data/dev.sqlite3

# Turso（vercel / deno / docker 默认使用；cloudflare 需同时设置 FORCE_TURSO=1 才生效）
TURSO_URL=
TURSO_AUTH_TOKEN=

# 仅 Cloudflare 部署时可选：强制改用 Turso 而不是 D1 binding
FORCE_TURSO=

# ---- 服务器 ----
# Deno Deploy / Docker 目标下 Deno.serve 监听端口；
# Cloudflare Workers / Vercel Edge 由平台自身决定入口，此项被忽略。
PORT=8787

# 前后端分离部署到不同源时允许的来源（同源部署留空即可，见 apps/server/src/app.js 的 cors 中间件）
CORS_ALLOWED_ORIGIN=

# ---- 日志（见 docs/Logging.md §4）----
# trace | debug | info | warn | error | fatal
# 不填时：DEPLOY_TARGET=local 默认 debug，其余环境默认 warn
LOG_LEVEL=debug

# ============================================================
# 仅本地开发使用（DEPLOY_TARGET=local），不要在任何部署环境设置
# ============================================================

# 首次 `just dev` 时若 settings:auth 尚未初始化，自动用此密码写入，
# 省去每次重建本地数据库都要走一遍首次设置向导，见 docs/Auth.md。
# 纯开发便利项，不属于 ARCHITECTURE.md 原有规范，如不需要可留空走正常首次设置流程。
DEV_SEED_AUTH_PASSWORD=change-me-in-dev

# ============================================================
# 仅本地手动执行 `just deploy:*` 时可能需要（CI 中改用 GitHub Actions
# Secrets，见 .github/workflows/deploy.yml）。
# 优先使用平台 CLI 原生登录方式（如 `deno run -A npm:wrangler login`），
# 避免把长期有效的 Token 明文放进本地文件。
# ============================================================

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VERCEL_TOKEN=
