#!/usr/bin/env -S deno run --allow-read
/**
 * commit-msg 钩子（docs/Commit.md §5）：
 * 1. 首行匹配 ^<type>(<scope>): <subject>{1,50}$
 * 2. 正文至少一行 `- <path>: <说明>`
 * 校验失败时指出具体不满足的部分。
 */
const TYPES = [
  "feat", "fix", "docs", "style", "refactor",
  "perf", "test", "build", "ci", "chore", "revert",
];

const msgFile = Deno.args[0];
if (!msgFile) {
  console.error("commit-msg: 缺少提交信息文件参数");
  Deno.exit(1);
}
const raw = await Deno.readTextFile(msgFile);
// 去掉注释行再取首个非空行与正文
const lines = raw.split(/\r?\n/).filter((l) => !l.startsWith("#"));
const first = lines.find((l) => l.trim().length > 0) ?? "";
const body = lines.slice(lines.indexOf(first) + 1);

const headRe = new RegExp(
  `^(${TYPES.join("|")})\\(([a-z0-9-]+)\\): (.+)$`,
);
const m = headRe.exec(first);

if (!m) {
  if (!/^(\w+)\(/.test(first) && !/^[a-z]+:/.test(first)) {
    console.error(
      `commit-msg: 首行不符合 Conventional Commits 格式：${first}\n` +
        `  期望：<type>(<scope>): <subject>`,
    );
  } else {
    const t = /^([a-z]+)/.exec(first)?.[1] ?? "";
    if (!TYPES.includes(t)) {
      console.error(
        `commit-msg: 非法 type "${t}"（允许：${TYPES.join("/")})`,
      );
    } else if (!/^\w+\([a-z0-9-]+\)/.test(first)) {
      console.error(
        `commit-msg: 缺少或非法 scope，期望形如 (notes)/(infra) 的小写字母/数字/连字符`,
      );
    } else {
      console.error(
        `commit-msg: 首行格式错误：${first}\n  期望：<type>(<scope>): <subject>`,
      );
    }
  }
  Deno.exit(1);
}

const subject = m[3];
if (subject.length > 50) {
  console.error(
    `commit-msg: subject 超过 50 字符（当前 ${subject.length}）：${subject}`,
  );
  Deno.exit(1);
}

const changeLineRe = /^- [\w./-]+: .+/;
if (!body.some((l) => changeLineRe.test(l))) {
  console.error(
    "commit-msg: 正文缺少逐文件改动行，至少一行形如：\n" +
      "  - path/to/file: 做了什么（到方法/组件级）",
  );
  Deno.exit(1);
}