# .env.example — 复制为 .env 使用（Deployment.md §1 环境变量矩阵）
# 注意：shell 里已 export 的同名变量会覆盖 .env（Deployment.md §9.1）

# 本地开发端口（just dev）
PORT=8790

# 部署目标：local|cloudflare|vercel|deno|docker（本地默认 local）
DEPLOY_TARGET=local

# 敏感字段加密密钥（Database.md §5.2）——生产必需，本地缺省用开发默认密钥
# APP_ENCRYPTION_KEY=change-me-please

# Turso（vercel/deno/docker 目标必需；cloudflare 需 FORCE_TURSO=1）
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# docker 目标改用本机磁盘 SQLite（VPS 有持久盘）
# LOCAL_SQLITE_PATH=./data/prod.sqlite3

# 日志级别：trace|debug|info|warn|error|fatal（local 默认 debug，其余 warn）
# LOG_LEVEL=debug
