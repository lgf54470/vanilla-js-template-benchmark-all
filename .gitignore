# ============================================================
# 依赖 —— 见 docs/Vendoring.md（Tier 0 目前仅 Hono；lockfile 入库，node_modules 不入库）
# ============================================================
node_modules/

# ============================================================
# 构建产物
# ============================================================
dist/
size-report.json
# vendored 库的 dist/ 是运行时源码本体而非构建产物，必须入库（docs/Vendoring.md）
!packages/lib/hono/dist/
!packages/lib/hono/dist/**

# ============================================================
# 本地数据与密钥 —— 见 ARCHITECTURE.md §18 安全基线、docs/Database.md §3
# ============================================================
.env
.env.local
.env.*.local
.data/
*.db
*.db-wal
*.db-shm

# ============================================================
# 平台 CLI 本地产物 —— 见 docs/Deployment.md
# ============================================================
.wrangler/               # Cloudflare：wrangler dev 本地状态/缓存
.dev.vars                # Cloudflare：本地机密文件（等价于 .env）
.vercel/                 # Vercel CLI 项目关联信息
.deployctl/              # Deno Deploy：deployctl 本地状态

# ============================================================
# 测试 / 临时 —— 见 docs/Testing.md §4（.e2e-profile 为 CDP 冒烟测试用的浏览器 profile）
# ============================================================
tmp/
*.log
.e2e-profile/
*.bak
coverage/

# ============================================================
# 编辑器 / 系统
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ============================================================
# 本地工具产物（用途待确认，见对话回复）
# ============================================================
.freebuff/
.zcode/
.reasonix/
.workbuddy/